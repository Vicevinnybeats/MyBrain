// MyBrain web app: a Cloudflare Worker built from this repository.
// Cloudflare rebuilds it on every push (Workers Builds, build command: sh build.sh).
// worker.js is copied in by build.sh from the MyBrain repository.
{
  "name": "mybrain",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Secrets live in Cloudflare Secrets Store; only their names are listed here.
  "secrets_store_secrets": [
    { "binding": "GITHUB_TOKEN", "store_id": "b3bdd5e6a19c48fbb6934dc0b8392753", "secret_name": "GITHUB_TOKEN" },
    { "binding": "ADD_KEY", "store_id": "b3bdd5e6a19c48fbb6934dc0b8392753", "secret_name": "ADD_KEY" }
  ],
  "vars": {
    "MAPS_REPO": "Vicevinnybeats/mybrain-maps"
  },
  // keep variables/secrets you add in the dashboard when this redeploys
  "keep_vars": true
}
